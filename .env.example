# Relay (ECS/VPS or local smoke test)
BRIDGE_CLIENT_TOKEN=replace-with-at-least-32-random-characters-for-the-browser
BRIDGE_CONNECTOR_TOKEN=replace-with-a-different-32-random-characters-for-the-connector
BRIDGE_SESSION_MAX_AGE_MS=3600000
BRIDGE_DEVICE_REGISTRY_FILE=./data/devices.json
# Optional Web Push. Generate a VAPID key pair and set all three values together.
# BRIDGE_PUSH_PUBLIC_KEY=
# BRIDGE_PUSH_PRIVATE_KEY=
# BRIDGE_PUSH_SUBJECT=https://codex.example.com
HOST=127.0.0.1
PORT=3300
CODEX_UI_LANGUAGE=zh-CN

# Enable only when the relay is reachable exclusively through a trusted proxy
# that overwrites X-Real-IP. compose.yaml configures this for its loopback-only relay.
BRIDGE_TRUST_PROXY=0

# Local connector (foreground and non-Windows setup)
# Both schemes are supported; wss:// is strongly recommended for public networks.
BRIDGE_URL=ws://127.0.0.1:3300/ws
BRIDGE_DEVICE_ID=personal-pc
# Non-Windows connectors may persist a mode-0600 device key here.
BRIDGE_DEVICE_IDENTITY_FILE=./data/connector-device.json
CODEX_BIN=codex
# Optional path list separated with the current OS path-list delimiter.
# Omit it to allow only the connector checkout.
# CODEX_ALLOWED_ROOTS=
CODEX_ALLOW_ANY_FILE_DOWNLOAD=0
CODEX_NETWORK_ACCESS=0
