BRIDGE_TOKEN=replace-with-at-least-32-random-characters
# Optional hardening: use distinct credentials for browser clients and the local connector.
# When omitted, both roles fall back to BRIDGE_TOKEN for compatibility.
BRIDGE_CLIENT_TOKEN=
BRIDGE_CONNECTOR_TOKEN=
BRIDGE_SESSION_MAX_AGE_MS=43200000
HOST=127.0.0.1
PORT=3300
CODEX_UI_LANGUAGE=zh-CN
# Both schemes are supported; wss:// is strongly recommended for public networks.
BRIDGE_URL=ws://127.0.0.1:3300/ws
BRIDGE_DEVICE_ID=personal-pc
CODEX_BIN=codex
CODEX_ALLOW_ANY_FILE_DOWNLOAD=0
CODEX_NETWORK_ACCESS=0
