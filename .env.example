BRIDGE_TOKEN=replace-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=3300
CODEX_UI_LANGUAGE=zh-CN
# Both schemes are supported; wss:// is strongly recommended for public networks.
BRIDGE_URL=ws://127.0.0.1:3300/ws
BRIDGE_DEVICE_ID=personal-pc
CODEX_BIN=codex
CODEX_WORKSPACE=C:\workspace
CODEX_ALLOWED_ROOTS=C:\workspace
CODEX_ALLOW_ANY_FILE_DOWNLOAD=0
CODEX_NETWORK_ACCESS=0
