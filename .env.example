# Relay configuration. `./scripts/relay.sh setup` creates the real .env.
BRIDGE_CONNECTOR_TOKEN=replace-with-at-least-32-random-characters-for-the-connector
BRIDGE_SESSION_MAX_AGE_MS=3600000
BRIDGE_TRUST_PROXY=1
CODEX_UI_LANGUAGE=zh-CN
# Optional development extension, exact unpacked ID from chrome://extensions. No wildcard.
# BRIDGE_EXTENSION_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# On each connector host (NOT Relay), enable private MCP IPC with an absolute protected path:
# BRIDGE_BROWSER_ENDPOINT_FILE=/private/connector-state/browser-endpoint.json
