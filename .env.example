BRIDGE_CLIENT_TOKEN=replace-with-at-least-32-random-characters-for-the-browser
BRIDGE_CONNECTOR_TOKEN=replace-with-a-different-32-random-characters-for-the-connector
BRIDGE_SESSION_MAX_AGE_MS=3600000
BRIDGE_DEVICE_REGISTRY_FILE=./data/devices.json
HOST=127.0.0.1
PORT=3300
CODEX_UI_LANGUAGE=zh-CN
# Both schemes are supported; wss:// is strongly recommended for public networks.
BRIDGE_URL=ws://127.0.0.1:3300/ws
BRIDGE_DEVICE_ID=personal-pc
# Non-Windows connectors may persist a mode-0600 device key here.
BRIDGE_DEVICE_IDENTITY_FILE=./data/connector-device.json
CODEX_BIN=codex
CODEX_ALLOW_ANY_FILE_DOWNLOAD=0
CODEX_NETWORK_ACCESS=0
