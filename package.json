{
  "name": "codex-anywhere",
  "version": "0.1.0",
  "description": "A self-hosted mobile web bridge for your local Codex sessions.",
  "keywords": [
    "openai-codex",
    "codex-desktop",
    "remote-control",
    "remote-access",
    "self-hosted",
    "mobile-web"
  ],
  "private": true,
  "license": "MIT",
  "repository": "github:gaotong132/codex-anywhere",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:node",
    "build:web": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "dev": "vite --host 127.0.0.1",
    "server": "npm run build && node build/server/index.js",
    "serve": "node build/server/index.js",
    "connector": "npm run build:node && node build/connector/index.js",
    "typecheck": "npm run typecheck:web && npm run typecheck:node && npm run typecheck:test",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "fast-xml-parser": "5.11.1",
    "file-type": "22.0.2",
    "lru-cache": "11.5.2",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.4",
    "sirv": "3.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "sass": "1.103.1",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
