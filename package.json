{
  "name": "codex-anywhere",
  "version": "0.4.5",
  "description": "A self-hosted mobile web bridge for your local Codex sessions.",
  "keywords": [
    "openai-codex",
    "codex-desktop",
    "remote-control",
    "remote-access",
    "self-hosted",
    "mobile-web"
  ],
  "private": true,
  "license": "MIT",
  "repository": "github:gaotong132/codex-anywhere",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:node",
    "build:web": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "build:extension": "vite build --config extension/vite.config.ts",
    "docs:hero": "tsx scripts/generate-readme-hero.ts",
    "dev": "vite --host 127.0.0.1",
    "server": "npm run build && node build/server/index.js",
    "serve": "node build/server/index.js",
    "connector": "npm run build:node && node build/connector/index.js",
    "typecheck": "npm run typecheck:web && npm run typecheck:node && npm run typecheck:test && npm run typecheck:extension",
    "typecheck:extension": "tsc -p extension/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:extension": "npm run build:extension && tsx --test extension/test/*.test.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm test && npm run check:docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "dompurify": "3.4.17",
    "fast-xml-parser": "5.11.1",
    "file-type": "22.1.1",
    "highlight.js": "11.12.0",
    "lru-cache": "11.5.2",
    "mermaid": "12.2.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.5",
    "sirv": "3.0.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "linkedom": "0.18.13",
    "sass": "1.105.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
